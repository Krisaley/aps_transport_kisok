APP_NAME="APS Transport"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://transport.example.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=transport
DB_USERNAME=transport
DB_PASSWORD=replace-with-random-secret
POSTGRES_DB=transport
POSTGRES_USER=transport
POSTGRES_PASSWORD=replace-with-the-same-database-secret
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-random-secret
REDIS_PORT=6379
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="System Administrator"
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
APP_IMAGE=ghcr.io/krisaley/aps-transport-app
WEB_IMAGE=ghcr.io/krisaley/aps-transport-web
RELEASE_TAG=local
CLOUDFLARE_TUNNEL_TOKEN=
BACKUP_RETENTION_DAYS=30
